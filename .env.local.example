# Copy to .env.local and fill in. Server-side only — never prefix with NEXT_PUBLIC_.

# Required for the AI assistant (src/app/api/copilotkit/route.ts).
OPENAI_API_KEY=

# Optional: override the model the assistant uses (defaults to the CopilotKit
# OpenAI adapter's default).
# OPENAI_MODEL=

# Optional: opt out of CopilotKit's anonymous runtime telemetry.
# COPILOTKIT_TELEMETRY_DISABLED=true
